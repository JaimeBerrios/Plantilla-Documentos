\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{plantilla/unab_presentacion}[2026/09/10 Tema Beamer institucional]

\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{booktabs}
\RequirePackage{fontawesome5}
\RequirePackage{tikz}
\RequirePackage{ragged2e}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{colortbl}
\RequirePackage{fontspec}
\RequirePackage{microtype}

\definecolor{unabblue}{HTML}{173864}
\definecolor{softgray}{HTML}{F2F2F2}
\definecolor{linegray}{HTML}{D8DEE8}

\usetheme{Boadilla}
\usecolortheme{whale}
\usefonttheme{professionalfonts}

\setbeamercolor{palette primary}{bg=unabblue, fg=white}
\setbeamercolor{palette secondary}{bg=unabblue!90, fg=white}
\setbeamercolor{palette tertiary}{bg=unabblue!80, fg=white}
\setbeamercolor{structure}{fg=unabblue}
\setbeamercolor{example text}{fg=unabblue}
\setbeamercolor{author in head/foot}{bg=unabblue, fg=white}
\setbeamercolor{title in head/foot}{bg=unabblue, fg=white}
\setbeamercolor{date in head/foot}{bg=unabblue, fg=white}
\setbeamercolor{frametitle}{bg=softgray, fg=unabblue}
\setbeamercolor{block title}{bg=unabblue, fg=white}
\setbeamercolor{block body}{bg=softgray, fg=black}
\setbeamercolor{block title example}{bg=unabblue!85, fg=white}
\setbeamercolor{block body example}{bg=softgray, fg=black}

\setbeamerfont{title}{series=\bfseries,size=\Large}
\setbeamerfont{frametitle}{series=\bfseries,size=\large}
\setbeamerfont{footline}{size=\scriptsize}

\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{items}[circle]
\setbeamersize{text margin left=0.8cm, text margin right=0.8cm}

\setbeamertemplate{frametitle}{
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,ht=3.5ex,dp=1.5ex,leftskip=0.8cm,rightskip=0.3cm]{frametitle}
    \usebeamerfont{frametitle}\insertframetitle
  \end{beamercolorbox}
}

\setbeamertemplate{blocks}[rounded][shadow=false]

\newcommand{\TemaFooterPresentacion}{Tema}
\newcommand{\CursoFooterPresentacion}{Asignatura}
\newcommand{\IconosPortada}{\faChalkboardTeacher \hspace{0.5cm} \faLaptopCode \hspace{0.5cm} \faUsers}

\newcommand{\setdatosfooter}[2]{%
  \renewcommand{\TemaFooterPresentacion}{#1}%
  \renewcommand{\CursoFooterPresentacion}{#2}%
}

\newcommand{\expositor}[1]{%
  \setbeamertemplate{footline}{%
    \leavevmode
    \hbox{%
      \begin{beamercolorbox}[wd=.30\paperwidth,ht=3.2ex,dp=1.2ex,center]{author in head/foot}
        \usebeamerfont{footline}\faBookmark\ \TemaFooterPresentacion
      \end{beamercolorbox}%
      \begin{beamercolorbox}[wd=.40\paperwidth,ht=3.2ex,dp=1.2ex,center]{title in head/foot}
        \usebeamerfont{footline}\faChalkboardTeacher\ \CursoFooterPresentacion
      \end{beamercolorbox}%
      \begin{beamercolorbox}[wd=.30\paperwidth,ht=3.2ex,dp=1.2ex,right]{date in head/foot}
        \usebeamerfont{footline}\faUser\ #1 \hspace*{1em} \faHashtag\ \insertframenumber{} / \inserttotalframenumber\hspace*{1.5ex}
      \end{beamercolorbox}%
    }
    \vskip0pt
  }%
}

% Se separan tema y equipo para conservar la legibilidad de títulos largos.
\newcommand{\portadainstitucional}{%
  {%
  \setbeamertemplate{footline}{}
  \begin{frame}[plain]
    \begin{center}
      \includegraphics[height=1.3cm,keepaspectratio]{assets/img/logo-vertical-completo.png}\par
      \vspace{0.15cm}
      {\small\color{unabblue}PROYECTO DE INVESTIGACIÓN\par}
      \vspace{0.05cm}
      {\color{unabblue}\bfseries\fontsize{20pt}{23pt}\selectfont\TituloTrabajo\par}
      \vspace{0.25cm}
      {\color{unabblue}\SubtituloTrabajo\par}
      \vspace{0.15cm}
      {\scriptsize\LugarFecha\par}
    \end{center}
  \end{frame}
  }%
  \expositor{Equipo}
  \begin{frame}{Datos académicos e integrantes}
    \textbf{Asignatura:} \Asignatura\par
    \textbf{Docente:} \Docente\par
    \textbf{Grupo:} \Grupo\par
    \medskip
    \begin{tabularx}{\textwidth}{@{}Xl@{}}
      \toprule
      \textbf{Nombre} & \textbf{Código} \\
      \midrule
      \Integrantes
      \bottomrule
    \end{tabularx}
    \medskip
    {\small Distribución de expositores pendiente de confirmar.\par}
    \vfill
    \centering\includegraphics[height=1.1cm,keepaspectratio]{assets/img/acreditacion.png}
  \end{frame}
}

\newcommand{\cierreinstitucional}[1][Muchas gracias por su atención]{%
  \expositor{\Grupo}
  \begin{frame}[plain]
    \begin{center}
      \vspace{1.5cm}
      {\color{unabblue}\Huge \faHandshake} \\
      \vspace{0.5cm}
      {\color{unabblue}\huge \bfseries #1 \par}
      \vspace{0.15cm}
      {\color{unabblue}\large Espacio para dudas y preguntas \par}
      \vfill
      {\scriptsize \textcolor{unabblue!80}{\Facultad \textperiodcentered\ \Institucion}}
    \end{center}
  \end{frame}
}
