\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{unab_presentacion}[2026/07/11 Tema Beamer institucional con Font Awesome]

\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{booktabs}
\RequirePackage{fontawesome5}
\RequirePackage{tikz}
\RequirePackage{ragged2e}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{colortbl}
\RequirePackage{lmodern}
\RequirePackage{microtype}

\definecolor{unabblue}{HTML}{173864}
\definecolor{softgray}{HTML}{F2F2F2}
\definecolor{linegray}{HTML}{D8DEE8}

\usetheme{Boadilla}
\usecolortheme{whale}
\usefonttheme{professionalfonts}

\setbeamercolor{palette primary}{bg=unabblue, fg=white}
\setbeamercolor{palette secondary}{bg=unabblue!90, fg=white}
\setbeamercolor{palette tertiary}{bg=unabblue!80, fg=white}
\setbeamercolor{structure}{fg=unabblue}
\setbeamercolor{author in head/foot}{bg=unabblue, fg=white}
\setbeamercolor{title in head/foot}{bg=unabblue, fg=white}
\setbeamercolor{date in head/foot}{bg=unabblue, fg=white}
\setbeamercolor{frametitle}{bg=softgray, fg=unabblue}
\setbeamercolor{block title}{bg=unabblue, fg=white}
\setbeamercolor{block body}{bg=softgray, fg=black}
\setbeamercolor{block title example}{bg=unabblue!85, fg=white}
\setbeamercolor{block body example}{bg=softgray, fg=black}

\setbeamerfont{title}{series=\bfseries,size=\Large}
\setbeamerfont{frametitle}{series=\bfseries,size=\large}
\setbeamerfont{footline}{size=\scriptsize}

\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{items}[circle]
\setbeamersize{text margin left=0.8cm, text margin right=0.8cm}

\setbeamertemplate{frametitle}{
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,ht=3.5ex,dp=1.5ex,leftskip=0.8cm,rightskip=0.3cm]{frametitle}
    \usebeamerfont{frametitle}\insertframetitle
  \end{beamercolorbox}
}

\setbeamertemplate{blocks}[rounded][shadow=false]

\newcommand{\TituloPresentacion}{TÍTULO DE LA PRESENTACIÓN}
\newcommand{\SubtituloPresentacion}{Asignatura o contexto}
\newcommand{\InstitucionPresentacion}{Nombre de la institución}
\newcommand{\FacultadPresentacion}{Nombre de la facultad}
\newcommand{\CatedraticoPresentacion}{Nombre del catedrático}
\newcommand{\GrupoPresentacion}{Grupo}
\newcommand{\TemaFooterPresentacion}{Tema}
\newcommand{\CursoFooterPresentacion}{Asignatura}
\newcommand{\LugarFechaPresentacion}{Lugar -- Fecha}
\newcommand{\IconosPortada}{\faChalkboardTeacher \hspace{0.5cm} \faLaptopCode \hspace{0.5cm} \faUsers}
\newcommand{\IntegrantesPresentacion}{%
  \textcolor{unabblue}{\faUser} & Nombre & \texttt{Código} \\
}

\newcommand{\setdatosfooter}[2]{%
  \renewcommand{\TemaFooterPresentacion}{#1}%
  \renewcommand{\CursoFooterPresentacion}{#2}%
}

\newcommand{\expositor}[1]{%
  \setbeamertemplate{footline}{%
    \leavevmode
    \hbox{%
      \begin{beamercolorbox}[wd=.30\paperwidth,ht=3.2ex,dp=1.2ex,center]{author in head/foot}
        \usebeamerfont{footline}\faBookmark\ \TemaFooterPresentacion
      \end{beamercolorbox}%
      \begin{beamercolorbox}[wd=.40\paperwidth,ht=3.2ex,dp=1.2ex,center]{title in head/foot}
        \usebeamerfont{footline}\faChalkboardTeacher\ \CursoFooterPresentacion
      \end{beamercolorbox}%
      \begin{beamercolorbox}[wd=.30\paperwidth,ht=3.2ex,dp=1.2ex,right]{date in head/foot}
        \usebeamerfont{footline}\faUser\ #1 \hspace*{1em} \faHashtag\ \insertframenumber{} / \inserttotalframenumber\hspace*{1.5ex}
      \end{beamercolorbox}%
    }
    \vskip0pt
  }%
}

\newcommand{\logoplaceholder}[1]{%
  \begin{tikzpicture}
    \node[
      draw=linegray,
      rounded corners=2pt,
      minimum width=2.3cm,
      minimum height=0.85cm,
      text=unabblue,
      font=\scriptsize\bfseries
    ] {#1};
  \end{tikzpicture}%
}

\newcommand{\portadainstitucional}{%
  {%
  \setbeamertemplate{footline}{}
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]
      \node[anchor=north west,xshift=0.55cm,yshift=-0.35cm] at (current page.north west)
      {\IfFileExists{img/logo-unab.png}{\includegraphics[height=0.95cm]{img/logo-unab.png}}{\logoplaceholder{LOGO}}};
      \node[anchor=north east,xshift=-0.55cm,yshift=-0.35cm] at (current page.north east)
      {\IfFileExists{img/logo-facultad.png}{\includegraphics[height=0.95cm]{img/logo-facultad.png}}{\logoplaceholder{FACULTAD}}};
    \end{tikzpicture}

    \vspace*{0.6cm}

    \begin{center}
      {\color{unabblue!40}\Large \IconosPortada} \\[0.2cm]
      {\color{unabblue}\bfseries\fontsize{18pt}{20pt}\selectfont \TituloPresentacion \par}
      \vspace{0.15cm}
      {\color{unabblue}\fontsize{10pt}{12pt}\selectfont \faChalkboard \ \SubtituloPresentacion \par}
      \vspace{0.1cm}
      {\color{unabblue}\rule{0.5\textwidth}{0.4pt}}
    \end{center}

    \vspace{0.1cm}

    \begin{center}
    \begin{minipage}{0.9\textwidth}
    \begin{beamercolorbox}[rounded=true,wd=\textwidth,sep=0.2cm,left]{block body}
      {\footnotesize\textcolor{unabblue}{\textbf{\faUserTie \ Catedrático:}} \CatedraticoPresentacion} \\[0.2cm]
      {\footnotesize\textcolor{unabblue}{\textbf{\faUsers \ Equipo expositor:}} \GrupoPresentacion} \\
      \vspace{0.1cm}
      {\fontsize{7.5pt}{9.5pt}\selectfont
      \begin{tabular}{@{}p{0.6cm}p{5.2cm}p{3cm}@{}}
        \IntegrantesPresentacion
      \end{tabular}}
    \end{beamercolorbox}
    \end{minipage}
    \end{center}

    \vspace{0.3cm}

    \begin{center}
      {\scriptsize \textcolor{unabblue}{\faMapMarkerAlt} \LugarFechaPresentacion}
    \end{center}
  \end{frame}
  }%
}

\newcommand{\cierreinstitucional}[1][Muchas gracias por su atención]{%
  \expositor{\GrupoPresentacion}
  \begin{frame}[plain]
    \begin{center}
      \vspace{1.5cm}
      {\color{unabblue}\Huge \faHandshake} \\
      \vspace{0.5cm}
      {\color{unabblue}\huge \bfseries #1 \par}
      \vspace{0.3cm}
      {\color{unabblue}\large Espacio para dudas y preguntas \par}
      \vfill
      {\scriptsize \textcolor{unabblue!60}{\FacultadPresentacion \textperiodcentered\ \InstitucionPresentacion}}
    \end{center}
  \end{frame}
}
